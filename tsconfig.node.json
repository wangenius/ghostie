{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/common/**/*",
    "src/main/**/*",
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/main/*"],
      "@common/*": ["./src/common/*"]
    },
    "experimentalDecorators": true,
  }
}
